{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "plugixa-exam/my-results",
	"version": "1.0.0",
	"title": "My results",
	"category": "widgets",
	"icon": "chart-bar",
	"description": "The signed-in learner's own results, with scores shown only once released.",
	"keywords": [
		"exam",
		"my results",
		"scores",
		"learner"
	],
	"textdomain": "plugixa-exam",
	"attributes": {
		"limit": {
			"type": "number",
			"default": 10
		}
	},
	"supports": {
		"html": false,
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"editorScript": "file:./index.js"
}
