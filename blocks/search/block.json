{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "plugixa-exam/search",
	"version": "1.0.0",
	"title": "Exam search",
	"category": "widgets",
	"icon": "search",
	"description": "A search box for the exam catalogue, with its results underneath.",
	"keywords": [
		"exam",
		"search",
		"find",
		"quiz"
	],
	"textdomain": "plugixa-exam",
	"attributes": {
		"per_page": {
			"type": "number",
			"default": 10
		}
	},
	"supports": {
		"html": false,
		"align": [
			"wide"
		],
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"editorScript": "file:./index.js"
}
